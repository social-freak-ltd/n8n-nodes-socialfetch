{
	"name": "n8n-nodes-socialfetch",
	"version": "0.16.0",
	"description": "Fetch social media and web data with the Social Fetch API.",
	"keywords": [
		"n8n-community-node-package",
		"socialfetch",
		"social-media",
		"tiktok",
		"instagram",
		"youtube",
		"twitter"
	],
	"license": "MIT",
	"homepage": "https://www.socialfetch.dev",
	"author": {
		"name": "Social Fetch",
		"email": "support@socialfetch.dev"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/social-freak-ltd/n8n-nodes-socialfetch.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=22"
	},
	"main": "dist/index.js",
	"scripts": {
		"build": "n8n-node build",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/SocialFetchApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/SocialFetch/SocialFetch.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.32.1",
		"eslint": "9.39.4",
		"n8n-workflow": "2.16.0",
		"prettier": "3.8.3",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
